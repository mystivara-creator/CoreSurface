# CoreSurface v1.0.0 Configuration (4-Tier Pure Experience Architecture)
# Tier Mode (selected via Volume Up/Down installer or WebUI):
#   auto | low | balanced_pro | flagship
CS_TIER_MODE=auto

# Live Motion Physics Profile (LSPosed Runtime — hot-reload without reboot):
#   hyperos4 | silk | 0
FEAT_MOTION_PROFILE=hyperos4

# Core User Toggles:
#   FEAT_SURGICAL_GUARD: 1 | 0 (HyperOS 3 Toast & Recent Apps fix, live)
#   FEAT_AOD_UNLOCK:     1 | 0 (Non-LTPO Always-On Display 10s-cap unlock)
FEAT_SURGICAL_GUARD=1
FEAT_AOD_UNLOCK=1
