# CoreSurface Standalone Configuration
# 4-Tier Mode: auto | low (Lite) | balanced_pro | flagship (Max Flagship)
# Native Flagship devices automatically use Passthrough when CS_TIER_MODE=auto.
CS_TIER_MODE=auto

# Core User Toggles:
#   FEAT_AOD_UNLOCK:     1 (Unlock Always/Scheduled AOD on Non-LTPO AMOLED, FOD-safe) | 0 (OFF)
#   FEAT_COLOR_EXPERT:   1 (Unlock Custom Color Expert Menu) | 0 (OFF)
#   FEAT_FLAGSHIP_AUDIO: auto (ON on all non-passthrough tiers) | 1 (Force ON) | 0 (OFF)
#   FEAT_FLAGSHIP_SUITE: auto (ON on Balanced Pro & Max Flagship) | 1 (Force ON) | 0 (OFF)
FEAT_AOD_UNLOCK=1
FEAT_COLOR_EXPERT=1
FEAT_FLAGSHIP_AUDIO=auto
FEAT_FLAGSHIP_SUITE=auto
