# CoreSurface v1.0.0 Configuration (4-Tier Pure Experience Architecture)
# Tier Mode (selected via Volume Up/Down installer or WebUI):
#   auto | low | balanced_pro | flagship
CS_TIER_MODE=auto

# Live Motion Physics Profile (LSPosed Runtime — hot-reload without reboot):
#   0 (Stock Flagship) | ios (iOS Fluid) | coloros (ColorOS Quantum) | hyperos4 (HyperOS 4 Crisp)
FEAT_MOTION_PROFILE=0

# Core User Toggles:
#   FEAT_SURGICAL_GUARD:  1 | 0 (HyperOS 3 Toast & Recent Apps fix, live)
#   FEAT_AOD_UNLOCK:      1 | 0 (Non-LTPO Always-On Display "Always" & "Scheduled" unlock)
#   FEAT_FLAGSHIP_AUDIO:  auto | 1 | 0 (Dolby/Hi-Fi/Mi Sound/Speaker Stereo & Clear Speaker/Sound Assistant)
#   FEAT_FLAGSHIP_SUITE:  auto | 1 | 0 (AI Image Engine, Video Toolbox, Dynamic Font Anim, Wild Boost, Live Photo)
FEAT_SURGICAL_GUARD=1
FEAT_AOD_UNLOCK=1
FEAT_FLAGSHIP_AUDIO=auto
FEAT_FLAGSHIP_SUITE=auto
